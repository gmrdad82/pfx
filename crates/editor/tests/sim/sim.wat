(component
  (core module $Main
    (memory (export "memory") 1)
    (global $state (mut i64) (i64.const 0))
    (global $steps (mut i32) (i32.const 0))
    (func $pack (result i32)
      (i64.store (i32.const 128) (global.get $state))
      (i32.store (i32.const 136) (global.get $steps))
      (i32.store (i32.const 64) (i32.const 128))
      (i32.store (i32.const 68) (i32.const 12))
      (i32.const 64))
    (func (export "new") (param $seed i64)
      (global.set $state (local.get $seed))
      (global.set $steps (i32.const 0)))
    (func (export "step") (param $order i32) (result i32)
      (global.set $state
        (i64.add (global.get $state) (i64.extend_i32_u (local.get $order))))
      (global.set $steps (i32.add (global.get $steps) (i32.const 1)))
      (i32.store (i32.const 192) (global.get $steps))
      (i32.store (i32.const 196)
        (i32.add (i32.wrap_i64 (global.get $state)) (i32.const OFFSET)))
      (i32.store (i32.const 72) (i32.const 192))
      (i32.store (i32.const 76) (i32.const 2))
      (i32.const 72))
    (func (export "snapshot") (result i32) (call $pack))
    (func (export "save") (result i32) (call $pack))
    (func (export "restore") (param $at i32) (param $len i32)
      (if (i32.eq (local.get $len) (i32.const 12))
        (then
          (global.set $state (i64.load (local.get $at)))
          (global.set $steps (i32.load (i32.add (local.get $at) (i32.const 8)))))))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (i32.const 256))
  )
  (core instance $main (instantiate $Main))
  (func $new (param "seed" u64)
    (canon lift (core func $main "new")))
  (func $step (param "order" u32) (result (list u32))
    (canon lift (core func $main "step") (memory $main "memory")))
  (func $snapshot (result (list u8))
    (canon lift (core func $main "snapshot") (memory $main "memory")))
  (instance $sim
    (export "new" (func $new))
    (export "step" (func $step))
    (export "snapshot" (func $snapshot)))
  (export "test:sim/sim@1.0.0" (instance $sim))
  (func (export "save") (result (list u8))
    (canon lift (core func $main "save") (memory $main "memory")))
  (func (export "restore") (param "state" (list u8))
    (canon lift (core func $main "restore") (memory $main "memory") (realloc (func $main "realloc"))))
)
