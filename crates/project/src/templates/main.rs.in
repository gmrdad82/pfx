#![cfg_attr(not(feature = "tools"), windows_subsystem = "windows")]

use std::process::ExitCode;

fn main() -> ExitCode {
    let (project, config) = match {{crate}}::project()
        .and_then(|project| {{crate}}::config(&project).map(|config| (project, config)))
    {
        Ok(found) => found,
        Err(error) => {
            eprintln!("{}: {error}", {{crate}}::NAME);
            return ExitCode::FAILURE;
        }
    };
    let settings = config.settings.clone();
    pfx_game::launch(
        move || {{crate}}::{{type}}::with(settings.clone()),
        config,
        |commands| tools(commands, project),
    )
}

#[cfg(feature = "tools")]
fn tools(commands: &mut pfx_game::Commands, project: pfx_project::Project) {
    commands
        .edit(
            "opens the game in pfx's editor; F5 plays it; --shot and --clip draw it offscreen",
            move |factory, args| {
                let config = {{crate}}::config(&project)?;
                pfx_workbench::edit_project(project.root(), factory, config, args)
            },
        )
        .usage("edit", pfx_workbench::EDIT_USAGE);
}

#[cfg(not(feature = "tools"))]
fn tools(_commands: &mut pfx_game::Commands, _project: pfx_project::Project) {}
