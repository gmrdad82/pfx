(module
  (import "pfx:play/scene@0.1.0" "find" (func $find (param i32 i32 i32)))
  (import "pfx:play/scene@0.1.0" "position" (func $position (param i32 i32)))
  (import "pfx:play/scene@0.1.0" "move-to" (func $move_to (param i32 f32 f32 f32)))
  (import "pfx:play/input@0.1.0" "held" (func $held (param i32 i32) (result i32)))
  (import "pfx:play/clock@0.1.0" "step" (func $step (result f32)))
  (import "pfx:play/hud@0.1.0" "text" (func $text (param i32 i32 i32)))
  (import "pfx:mods/log@0.1.0" "line" (func $line (param i32 i32)))
  (memory (export "memory") 1)
  (data (i32.const 16) "marker")
  (data (i32.const 32) "Left")
  (data (i32.const 40) "Right")
  (data (i32.const 48) "Up")
  (data (i32.const 56) "Down")
  (data (i32.const 96) "no object named marker; the keys move nothing")
  (data (i32.const 512) "score ")
  (global $object (mut i32) (i32.const -1))
  (global $score (mut i32) (i32.const 0))

  (func $show
    (local $n i32)
    (local $at i32)
    (local.set $n (global.get $score))
    (local.set $at (i32.const 640))
    (loop $digits
      (local.set $at (i32.sub (local.get $at) (i32.const 1)))
      (i32.store8 (local.get $at)
        (i32.add (i32.const 48) (i32.rem_u (local.get $n) (i32.const 10))))
      (local.set $n (i32.div_u (local.get $n) (i32.const 10)))
      (br_if $digits (local.get $n)))
    (memory.copy (i32.const 518) (local.get $at) (i32.sub (i32.const 640) (local.get $at)))
    (call $text (i32.const 0) (i32.const 512)
      (i32.add (i32.const 6) (i32.sub (i32.const 640) (local.get $at)))))

  (func $axis (param $minus i32) (param $minus_len i32) (param $plus i32) (param $plus_len i32) (result f32)
    (f32.sub
      (f32.convert_i32_u (call $held (local.get $plus) (local.get $plus_len)))
      (f32.convert_i32_u (call $held (local.get $minus) (local.get $minus_len)))))

  (func (export "start")
    (global.set $score (i32.const 0))
    (call $find (i32.const 16) (i32.const 6) (i32.const 256))
    (if (i32.load8_u (i32.const 256))
      (then (global.set $object (i32.load (i32.const 260))))
      (else
        (global.set $object (i32.const -1))
        (call $line (i32.const 96) (i32.const 45))))
    (call $show))

  (func (export "tick")
    (local $dx f32)
    (local $dz f32)
    (local $speed f32)
    (if (i32.lt_s (global.get $object) (i32.const 0)) (then (return)))
    (local.set $dx (call $axis (i32.const 32) (i32.const 4) (i32.const 40) (i32.const 5)))
    (local.set $dz (call $axis (i32.const 48) (i32.const 2) (i32.const 56) (i32.const 4)))
    (if (i32.and (f32.eq (local.get $dx) (f32.const 0)) (f32.eq (local.get $dz) (f32.const 0)))
      (then (return)))
    (local.set $speed (f32.mul (f32.const 2) (call $step)))
    (call $position (global.get $object) (i32.const 256))
    (call $move_to (global.get $object)
      (f32.add (f32.load (i32.const 256)) (f32.mul (local.get $dx) (local.get $speed)))
      (f32.load (i32.const 260))
      (f32.add (f32.load (i32.const 264)) (f32.mul (local.get $dz) (local.get $speed))))
    (global.set $score (i32.add (global.get $score) (i32.const 1)))
    (call $show))
)
