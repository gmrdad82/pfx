#!/usr/bin/env bash
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2

game_crates=(core geom gpu materials text post load physics sound trace bake live input steam mod play film)

steam_alone() {
  local out
  out=$(cargo tree -i pfx-steam --workspace -e normal,build,dev --prefix none 2>/dev/null)
  ! printf '%s\n' "$out" | grep -Ev "^pfx-steam( |$)"
}

report_alone() {
  local out
  out=$(cargo tree -i pfx-report --workspace -e normal,build --prefix none 2>/dev/null)
  ! printf '%s\n' "$out" | grep -E "^pfx-(core|gpu|geom|materials|text|post|live|trace|bake|load|physics|sound|steam|input|film) "
}

fails=()
step() {
  local name=$1
  shift
  echo "gate: $name"
  if ! "$@"; then
    fails+=("$name")
  fi
}

meshopt_lint() {
  step geom-clippy cargo clippy -p pfx-geom --all-targets -- -D warnings
  step geom-meshopt-clippy cargo clippy -p pfx-geom --all-targets --features meshopt -- -D warnings
  step live-clippy cargo clippy -p pfx-live --all-targets -- -D warnings
  step live-meshopt-clippy cargo clippy -p pfx-live --all-targets --features meshopt -- -D warnings
}

meshopt_tests() {
  step geom-tests cargo test -p pfx-geom --lib
  step geom-meshopt-tests cargo test -p pfx-geom --lib --features meshopt
  step live-lod-tests cargo test -p pfx-live --lib lod::tests
}

lint() {
  step fmt cargo fmt --all --check
  step clippy cargo clippy --workspace --all-targets -- -D warnings
  step game-clippy cargo clippy -p pfx-game --all-targets --features tools,steam,dev-hud,modules -- -D warnings
  step core-serde-clippy cargo clippy -p pfx-core --all-targets --features serde -- -D warnings
  meshopt_lint
  step agnostic cargo test -q --test agnostic
  step self-contained cargo test -q --test self_contained
  step brand cargo test -q --test brand
  step licences cargo test -q --test licences
  step native cargo test -q --test native
  step charts cargo test -q --test charts
  step steam-alone steam_alone
  step report-alone report_alone
}

tests() {
  step build cargo build --workspace --bins --examples
  step tests cargo test --workspace --all-targets
  meshopt_tests
  step game-tests cargo test -p pfx-game --lib --features tools,steam
  step core-serde cargo test -p pfx-core --lib --features serde
  step doc-tests cargo test --workspace --doc
}

changed_packages() {
  local base path dir name
  base=$(git merge-base HEAD "${GATE_BASE:-origin/main}" 2>/dev/null || git merge-base HEAD main 2>/dev/null) || return 1
  while IFS= read -r path; do
    case $path in
      "") ;;
      Cargo.toml | Cargo.lock | rust-toolchain* | .cargo/*) return 1 ;;
      crates/*/*)
        dir=${path#crates/}
        dir=${dir%%/*}
        name=$(sed -n 's/^name = "\(.*\)"$/\1/p' "crates/$dir/Cargo.toml" 2>/dev/null | head -n 1)
        [ -n "$name" ] && echo "$name"
        ;;
      src/* | tests/* | examples/* | build.rs) echo pfx ;;
    esac
  done < <({
    git diff --name-only "$base"
    git ls-files --others --exclude-standard
  } | sort -u)
  echo pfx
}

fast() {
  local names picks=() name
  step fmt cargo fmt --all --check
  step clippy cargo clippy --workspace --all-targets -- -D warnings
  step game-clippy cargo clippy -p pfx-game --all-targets --features tools,steam,dev-hud,modules -- -D warnings
  step build cargo build -p pfx --bins --examples
  meshopt_lint
  if names=$(changed_packages); then
    for name in $(printf '%s\n' "$names" | sort -u); do
      picks+=(-p "$name")
    done
    step unit-tests cargo test "${picks[@]}" --lib --bins
  else
    step unit-tests cargo test --workspace --lib --bins
  fi
  meshopt_tests
  step game-tests cargo test -p pfx-game --lib --features tools,steam
  step agnostic cargo test -q --test agnostic
  step self-contained cargo test -q --test self_contained
  step brand cargo test -q --test brand
  step licences cargo test -q --test licences
  step native cargo test -q --test native
  step charts cargo test -q --test charts
  step steam-alone steam_alone
  step report-alone report_alone
}

vendored() {
  local dir=tmp/vendored rev manifest name
  rev=$(git rev-parse HEAD) || return 1
  if ! git diff --quiet HEAD -- crates; then
    echo "gate: vendored builds the crates as committed at $rev, without the working tree's changes"
  fi
  rm -rf "$dir/vendor" "$dir/.cargo"
  mkdir -p "$dir/src" "$dir/.cargo"
  {
    printf '[package]\nname = "vendored"\nversion = "0.0.0"\nedition = "2024"\npublish = false\n\n[workspace]\n\n[dependencies]\n'
    for manifest in crates/*/Cargo.toml; do
      [ -f "${manifest%Cargo.toml}src/lib.rs" ] || continue
      name=$(sed -n 's/^name = "\(.*\)"$/\1/p' "$manifest" | head -n 1)
      printf '%s = { git = "file://%s", rev = "%s" }\n' "$name" "$PWD" "$rev"
    done
  } > "$dir/Cargo.toml"
  : > "$dir/src/lib.rs"
  cp Cargo.lock "$dir/Cargo.lock"
  (
    cd "$dir" && export CARGO_NET_GIT_FETCH_WITH_CLI=true &&
      cargo vendor vendor > .cargo/config.toml &&
      cargo check --offline --lib
  )
}

release() {
  step release cargo build --release -p pfx --bins
}

copy_steam_dll() {
  local dll
  dll=$(find target/debug/build -name steam_api64.dll -print -quit 2>/dev/null)
  if [ -n "$dll" ]; then
    cp "$dll" target/debug/deps/
  fi
}

os_lint() {
  step "$1-clippy" cargo clippy --workspace --all-targets -- -D warnings
}

os_tests() {
  step "$1-build" cargo build --workspace --bins --examples
  step "$1-test-build" cargo test --workspace --lib --bins --no-run
  step "$1-steam-dll" copy_steam_dll
  step "$1-tests" cargo test --workspace --lib --bins
}

windows-lint() {
  os_lint windows
}

windows() {
  local args=() crate
  for crate in "${game_crates[@]}"; do
    args+=(-p "pfx-$crate")
  done
  os_tests windows
  step windows-game-tests cargo test "${args[@]}" --test '*'
}

macos-lint() {
  os_lint macos
}

macos() {
  os_tests macos
}

case ${1:-} in
  "") lint; tests; step vendored vendored ;;
  --fast | fast) fast ;;
  vendored) step vendored vendored ;;
  lint | tests | release | windows | windows-lint | macos | macos-lint) "$1" ;;
  *)
    echo "gate: unknown phase $1 (--fast, lint, tests, vendored, release, windows, windows-lint, macos or macos-lint)" >&2
    exit 2
    ;;
esac
if [ ${#fails[@]} -gt 0 ]; then
  echo "gate: RED, failed: ${fails[*]}"
  exit 1
fi
echo "gate: green"
