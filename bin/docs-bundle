#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/docs-bundle [--no-api] [<version>] [<out dir>]

Builds docs-v<version>.tar.gz (one docs/ folder of Starlight pages, images and the
API reference) and notes-v<version>.md (that version's CHANGELOG section) in <out dir>.
<version> defaults to the workspace version, <out dir> to tmp/docs.
EOF
}

refuse() {
  printf "error: unexpected argument '%s' found\n\nUsage: bin/docs-bundle [--no-api] [<version>] [<out dir>]\n\nFor more information, try '--help'.\n" "$1" >&2
  exit 2
}

root=$(cd "$(dirname "$0")/.." && pwd)
api=1
args=()
for arg in "$@"; do
  case $arg in
    --no-api) api=0 ;;
    -h|--help) usage; exit 0 ;;
    -*) refuse "$arg" ;;
    *) args+=("$arg") ;;
  esac
done
if [ ${#args[@]} -gt 2 ]; then
  refuse "${args[2]}"
fi

version=${args[0]:-}
if [ -z "$version" ]; then
  version=$(sed -n '/^\[workspace.package\]/,/^\[/s/^version = "\(.*\)"/\1/p' "$root/Cargo.toml" | head -n 1)
fi
version=${version#v}
case $version in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) echo "docs-bundle: '$version' is not a version like 1.2.3" >&2; exit 1 ;;
esac
tag=v$version

out=${args[1]:-$root/tmp/docs}
mkdir -p "$out"
out=$(cd "$out" && pwd)
stage=$out/stage-$tag
rm -rf "$stage"
trap 'rm -rf "$stage"' EXIT
mkdir -p "$stage/docs"

crates=$(cd "$root" && cargo metadata --format-version 1 --no-deps | python3 -c '
import json, sys
meta = json.load(sys.stdin)
names = []
for package in meta["packages"]:
    if package["name"] == "pfx":
        continue
    if any("lib" in target["kind"] for target in package["targets"]):
        names.append(package["name"])
print(" ".join(sorted(names)))
')

if [ "$api" = 1 ]; then
  target=$(cd "$root" && cargo metadata --format-version 1 --no-deps | python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])')
  rm -rf "$target/doc"
  (cd "$root" && cargo doc --no-deps --workspace --exclude pfx --lib)
  cp -R "$target/doc" "$stage/docs/api"
fi

python3 - "$root" "$stage/docs" "$tag" "$out/notes-$tag.md" "$api" "$crates" <<'PY'
import json
import os
import posixpath
import re
import sys

root, dest, tag, notes_path, api, crates = sys.argv[1:7]
api = api == "1"
crates = crates.split()
repo = "https://github.com/gmrdad82/pfx"
estate = {"pfx-scene", "manfred", "prec", "pconv", "pito-compare", "pito-codecs"}

GUIDES = [
    ("first-game", 101, "Scaffold a game with pfx new, play it with cargo run, open it in the editor and measure it with pfx bench."),
    ("projects", 102, "A game on pfx is its own repo and one binary: what pfx new scaffolds, the project.toml, and how a game plays and opens in the editor."),
    ("game", 103, "pfx-game, the one call a game's main makes: the window, pacing, input, sound, the fixed tick and the game's own launcher."),
    ("scenes", 104, None),
    ("play", 201, None),
    ("input", 202, "pfx-input: keyboard, mouse and controllers behind one action map, with controller glyphs, rumble and input recording."),
    ("sound", 203, None),
    ("physics", 204, None),
    ("characters", 205, None),
    ("camera-rigs", 206, None),
    ("animation", 207, "Skeletal animation from glTF, node animation, and sprite clips from an image atlas, all deterministic by tick, drawn live with GPU skinning and traced in the same pose."),
    ("screens", 208, None),
    ("window", 209, "pfx-gpu's window feature: the display mode, the present mode, the render size and the frame cap."),
    ("sim", 210, None),
    ("shots", 211, None),
    ("director", 212, None),
    ("journal", 213, None),
    ("numbers", 214, None),
    ("words", 215, None),
    ("easings", 216, None),
    ("mods", 217, None),
    ("live-renderer", 301, "The live renderer's design: its frame budget at 4K, passes, shadows, baked light, TAA, text, frames on demand and dynamic resolution."),
    ("benchmark-a-scene", 302, None),
    ("frame-stats", 303, None),
    ("pacing", 304, None),
    ("gpu-floor", 305, None),
    ("plates", 306, None),
    ("flat", 307, None),
    ("flat-styles", 308, None),
    ("flat-looks", 309, None),
    ("effects", 310, None),
    ("text", 311, None),
    ("materials", 312, None),
    ("render-a-still", 313, None),
    ("trace", 314, None),
    ("trace-lights", 315, None),
    ("trace-film", 316, None),
    ("denoise", 317, None),
    ("bake", 318, "pfx bake traces a scene's probe volumes, prerendered props, plates and detail maps on the GPU and writes versioned, checked artifacts the live renderer shows."),
    ("geom-assets", 319, "pfx-geom's asset geometry on the CPU: SVG marks as extruded, bevelled solids and icon parts fused through a distance field."),
    ("editor", 401, None),
    ("editor-crates", 402, None),
    ("windows", 501, "Games on pfx build for Windows: the one build Steam ships, which Linux and the Steam Deck run through Proton."),
    ("steam", 502, None),
    ("wgpu30", 503, None),
    ("agnostic", 504, None),
]

FORMATS = [
    ("Scenes and projects", "Scenes are pfx-scene's TOML format; a project is a folder with a project.toml.", [("scenes", "The format is pfx-scene's"), ("projects", "A project")]),
    ("Material libraries", "One TOML file of named materials that both renderers and the bake share.", [("materials", None)]),
    ("Frame stats", "One JSON line per presented frame, and an end line.", [("frame-stats", "The line"), ("frame-stats", "The end line")]),
    ("The bench summary", "The JSON line pfx bench prints last.", [("frame-stats", "The summary")]),
    ("Input journals", "The compact binary input log a game ships and verifies headless.", [("journal", "The bytes")]),
    ("Input recordings", "The engine's own JSON log of a session's input, which pfx bench --replay reads.", [("input", "Recording and replay")]),
    ("Steam depots", "The manifest pfx steam stage reads and the files it writes.", [("steam", "steam.toml"), ("steam", "What gets written")]),
    ("Baked detail atlases", "What pfx bake --detail writes and the engine loads.", [("bake", "Files and manifest")]),
]

SKIP = {"format", "formats"}


def fail(message):
    print(f"docs-bundle: {message}", file=sys.stderr)
    sys.exit(1)


def read(path):
    with open(os.path.join(root, path), encoding="utf-8") as handle:
        return handle.read()


def write(path, text):
    full = os.path.join(dest, path)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    with open(full, "w", encoding="utf-8") as handle:
        handle.write(text)


docs = sorted(name[:-3] for name in os.listdir(os.path.join(root, "docs")) if name.endswith(".md"))
listed = [name for name, _, _ in GUIDES]
missing = [name for name in docs if name not in listed and name not in SKIP]
if missing:
    fail("docs/" + ", docs/".join(f"{name}.md" for name in missing) + " not placed in the bundle's GUIDES list")
absent = [name for name in listed if name not in docs]
if absent:
    fail("GUIDES names pages that do not exist: " + ", ".join(absent))

pages = {"README.md": "index.md", "CHANGELOG.md": "changelog.md", "docs/format.md": "reference/formats.md", "docs/formats.md": "reference/formats.md"}
for name in listed:
    pages[f"docs/{name}.md"] = f"guides/{name}.md"


def plain(text):
    text = re.sub(r"!\[[^\]]*\]\([^)]*\)", "", text)
    text = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", text)
    text = text.replace("`", "").replace("**", "")
    return re.sub(r"\s+", " ", text).strip()


def heading_title(text):
    for line in text.splitlines():
        if line.startswith("# "):
            return plain(line[2:])
    fail("a page has no title heading")


def first_sentence(text):
    para = []
    fenced = False
    for line in text.splitlines():
        if line.startswith("```"):
            fenced = not fenced
            continue
        if fenced or line.startswith("#") or line.startswith("|") or line.startswith("<") or line.startswith("!["):
            if para:
                break
            continue
        if not line.strip():
            if para:
                break
            continue
        para.append(line.strip())
    body = re.sub(r"`docs/([a-z0-9-]+)\.md`", lambda m: titles.get(f"docs/{m.group(1)}.md", m.group(0)), " ".join(para))
    body = plain(body)
    match = re.search(r"^(.+?(?<!e\.g)(?<!i\.e)[.!?])(?=\s|$)", body)
    return match.group(1) if match else body


titles = {}
for name in listed:
    titles[f"docs/{name}.md"] = heading_title(read(f"docs/{name}.md"))
titles["README.md"] = "pfx"
titles["CHANGELOG.md"] = "Changelog"
titles["docs/format.md"] = "Formats"
titles["docs/formats.md"] = "Formats"


moved = {"install-and-first-use": "install.md", "build-and-test": "install.md#build-pfx-from-source"}


def link_to(page_out, target_out):
    return posixpath.relpath(target_out, posixpath.dirname(page_out) or ".")


def resolve(target, source, page_out, moved_from):
    if target.startswith("bundle:"):
        path, _, anchor = target[len("bundle:"):].partition("#")
        return link_to(page_out, path) + ("#" + anchor if anchor else "")
    if re.match(r"^[a-z]+:", target):
        match = re.match(r"^https://github\.com/gmrdad82/([A-Za-z0-9_.-]+)", target)
        if match and match.group(1) != "pfx":
            name = match.group(1).lower()
            return f"https://docs.pitomd.com/{name}/"
        return target
    path, _, anchor = target.partition("#")
    if not path:
        if moved_from:
            return link_to(page_out, pages[moved_from]) + "#" + anchor
        return target
    repo_path = posixpath.normpath(posixpath.join(posixpath.dirname(source), path))
    suffix = "#" + anchor if anchor else ""
    if repo_path == "README.md" and anchor in moved:
        return link_to(page_out, moved[anchor])
    if repo_path in pages:
        return link_to(page_out, pages[repo_path]) + suffix
    if repo_path.startswith("docs/images/"):
        return link_to(page_out, "images/" + repo_path[len("docs/images/"):])
    if repo_path.startswith(".."):
        fail(f"{source} links outside the repository: {target}")
    kind = "tree" if os.path.isdir(os.path.join(root, repo_path)) else "blob"
    if not os.path.exists(os.path.join(root, repo_path)):
        fail(f"{source} links to a missing file: {target}")
    return f"{repo}/{kind}/{tag}/{repo_path}{suffix}"


LINK = re.compile(r"(!?)\[((?:[^\[\]]|\[[^\]]*\])*)\]\(([^)\s]+)\)")
IMG = re.compile(r"<img\s[^>]*>")
CODE_DOC = re.compile(r"`(docs/[a-z0-9-]+\.md)`")


def attr(tag_text, name):
    match = re.search(name + r'="([^"]*)"', tag_text)
    return match.group(1) if match else ""


def label(text, target, source):
    path = target.partition("#")[0]
    if re.fullmatch(r"(docs/)?[a-z0-9-]+\.md", text) and path:
        repo_path = posixpath.normpath(posixpath.join(posixpath.dirname(source), path))
        if repo_path in titles and repo_path.startswith("docs/"):
            return titles[repo_path]
    return text


def rewrite_prose(text, source, page_out, moved_from):
    def html_image(match):
        alt = attr(match.group(0), "alt").replace("[", "(").replace("]", ")")
        return f"![{alt}]({attr(match.group(0), 'src')})"

    text = re.sub(r"<picture>.*?</picture>\n*", "", text, flags=re.S)
    text = IMG.sub(html_image, text)

    def code_doc(match):
        path = match.group(1)
        if path in pages and path in titles:
            return f"[{titles[path]}]({path[len('docs/'):] if source.startswith('docs/') else path})"
        return match.group(0)

    parts = re.split(r"(`[^`]*`)", text)
    for index, part in enumerate(parts):
        if part.startswith("`") and part.endswith("`") and len(part) > 1:
            if CODE_DOC.fullmatch(part):
                parts[index] = code_doc(CODE_DOC.fullmatch(part))
            continue
    text = "".join(parts)

    parts = re.split(r"(`[^`]*`)", text)
    out = []
    for part in parts:
        if part.startswith("`") and part.endswith("`") and len(part) > 1:
            out.append(part)
            continue
        out.append(LINK.sub(lambda m: f"{m.group(1)}[{label(m.group(2), m.group(3), source)}]({resolve(m.group(3), source, page_out, moved_from)})", part))
    return "".join(out)


def rewrite(text, source, page_out, moved_from=None):
    lines = text.split("\n")
    out = []
    fenced = False
    block = []
    for line in lines:
        if line.lstrip().startswith("```"):
            if not fenced:
                out.append(rewrite_prose("\n".join(block), source, page_out, moved_from))
                block = []
            fenced = not fenced
            out.append(line)
            continue
        if fenced:
            out.append(line)
        else:
            block.append(line)
    out.append(rewrite_prose("\n".join(block), source, page_out, moved_from))
    text = "\n".join(part for part in out)
    text = re.sub(r'^<p align="center">\s*$\n?', "", text, flags=re.M)
    text = re.sub(r"^</p>\s*$\n?", "", text, flags=re.M)
    text = re.sub(r'^<p align="center">(!\[.*\]\(.*\))</p>$', r"\1", text, flags=re.M)
    return text


def front(title, description, order):
    return "---\n" + f"title: {json.dumps(title, ensure_ascii=False)}\n" + f"description: {json.dumps(description, ensure_ascii=False)}\n" + f"sidebar:\n  order: {order}\n" + "---\n\n"


def strip_title(text):
    lines = text.split("\n")
    for index, line in enumerate(lines):
        if line.startswith("# "):
            rest = lines[index + 1:]
            while rest and not rest[0].strip():
                rest.pop(0)
            return "\n".join(lines[:index] + rest)
    return text


def sections(text):
    found = []
    current = None
    fenced = False
    for line in text.split("\n"):
        if line.startswith("```"):
            fenced = not fenced
        match = None if fenced else re.match(r"^(#{2,6}) (.*)$", line)
        if match:
            current = [match.group(2), len(match.group(1)), []]
            found.append(current)
        if current is not None:
            current[2].append(line)
    return found


def section(text, heading):
    if heading is None:
        lines = strip_title(text).split("\n")
        kept = []
        for line in lines:
            if re.match(r"^#{2,6} ", line):
                break
            kept.append(line)
        return "\n".join(kept).strip("\n"), 2
    found = sections(text)
    for index, (name, level, body) in enumerate(found):
        if plain(name) == heading:
            collected = list(body)
            for later_name, later_level, later_body in found[index + 1:]:
                if later_level <= level:
                    break
                collected.extend(later_body)
            return "\n".join(collected).strip("\n"), level
    fail(f"no section '{heading}' to take into the formats page")


def demote(text, level, to):
    shift = to - level
    out = []
    fenced = False
    for line in text.split("\n"):
        if line.startswith("```"):
            fenced = not fenced
        match = None if fenced else re.match(r"^(#{2,6}) (.*)$", line)
        if match:
            line = "#" * min(6, len(match.group(1)) + shift) + " " + match.group(2)
        out.append(line)
    return "\n".join(out)


def anchor(heading):
    slug = plain(heading).lower()
    slug = re.sub(r"[^\w\- ]", "", slug)
    return slug.replace(" ", "-")


readme = read("README.md")
blocks = sections(readme)
top = readme.split("\n## ")[0]
top_lines = [line for line in top.split("\n") if not line.startswith("# ") and not line.startswith("[![")]
top = re.sub(r"\n{3,}", "\n\n", "\n".join(top_lines)).strip("\n")
by_name = {name: "\n".join(body).strip("\n") for name, level, body in blocks if level == 2}
for needed in ("Install and first use", "Build and test", "The crates"):
    if needed not in by_name:
        fail(f"README has no '## {needed}' section")

index_parts = [top, "Install it and make a first game: [Install](bundle:install.md). Every command of the `pfx` tool: [The pfx tool](bundle:reference/cli.md)."]
for name, level, body in blocks:
    if level != 2 or name in ("Install and first use", "Build and test"):
        continue
    text = "\n".join(body).strip("\n")
    if name == "The crates" and api:
        text = re.sub(r"^\| `(pfx-[a-z-]+)`", lambda m: f"| [`{m.group(1)}`](bundle:api/{m.group(1).replace('-', '_')}/index.html)" if m.group(1) in crates else m.group(0), text, flags=re.M)
        text = text.replace("Each is a package in this workspace that a game or app can link by tag:", "Each is a package in this workspace that a game or app can link by tag; its name links to its API reference ([all crates](bundle:api/index.html)):")
    if name == "The crates":
        text += "\n\nEvery command and flag: [The pfx tool](bundle:reference/cli.md)."
    index_parts.append(text)
index_body = rewrite("\n\n".join(index_parts), "README.md", "index.md")
intro = first_sentence(top)
write("index.md", front("pfx", intro, 1) + index_body.strip("\n") + "\n")

install = by_name["Install and first use"].split("\n", 1)[1].strip("\n")
build = by_name["Build and test"].split("\n", 1)[1].strip("\n")
install_body = "\n\n".join([
    install,
    "## Next steps\n\n- [Make your first game](docs/first-game.md): scaffold, play, edit and bench a game.\n- [Benchmark a scene](docs/benchmark-a-scene.md): a repeatable headless load with frame stats.\n- [Render a still with the path tracer](docs/render-a-still.md): an offline frame, traced and denoised.\n- [The pfx tool](bundle:reference/cli.md): every command and flag.",
    "## Build pfx from source\n\n" + build,
])
install_body = rewrite(install_body, "README.md", "install.md")
write("install.md", front("Install", "Install the pfx tool on Linux, make a game and play it, and link the engine's crates from a game that builds on Linux, Windows and macOS.", 2) + install_body.strip("\n") + "\n")

for name, order, override in GUIDES:
    source = f"docs/{name}.md"
    text = read(source)
    description = override or first_sentence(strip_title(text))
    body = rewrite(strip_title(text), source, f"guides/{name}.md")
    write(f"guides/{name}.md", front(titles[source], description, order) + body.strip("\n") + "\n")

formats = ["pfx promises the JSON outputs and file formats below; each section is taken from the guide that owns it, which says more. A schema version or format number changes only with its page."]
for heading, summary, picks in FORMATS:
    formats.append(f"## {heading}\n\n{summary}")
    for name, picked in picks:
        source = f"docs/{name}.md"
        text, level = section(read(source), picked)
        where = f"guides/{name}.md" + (f"#{anchor(picked)}" if picked else "")
        if picked:
            text = demote(text, level, 3)
            formats.append(text + f"\n\nFrom [{titles[source]}](bundle:{where}).")
        else:
            formats.append(text + f"\n\nFrom [{titles[source]}](bundle:{where}).")
        formats[-1] = rewrite(formats[-1], source, "reference/formats.md", moved_from=source)
write("reference/formats.md", front("Formats", "The JSON outputs and file formats pfx promises: scenes and projects, material libraries, frame stats, the bench summary, input journals and recordings, Steam depots and baked atlases.", 902) + "\n\n".join(formats).strip("\n") + "\n")

main_rs = read("src/main.rs")


def rust_str(name, text):
    match = re.search(r"const " + name + r': &str = "((?:[^"\\]|\\.)*)";', text, re.S)
    if not match:
        fail(f"src/main.rs has no {name} string")
    return match.group(1).replace('\\"', '"').replace("\\\\", "\\")


def rust_list(name):
    match = re.search(r"const " + name + r": &\[&str\] = &\[(.*?)\];", main_rs, re.S)
    if not match:
        fail(f"src/main.rs has no {name} list")
    return re.findall(r'"([^"]*)"', match.group(1))


about = rust_str("ABOUT", main_rs)
usage_text = rust_str("USAGE", main_rs)
switches = set(rust_list("SWITCHES"))
shapes = dict(re.findall(r'"([a-z]+)" => \{?\s*"([^"]+)"', main_rs))
commands = [command for command in rust_list("COMMANDS") if command != "help"]
cli = [about, "`pfx --help` prints:", "```\n" + about + "\n\n" + usage_text + "\n```"]
cli.append("## Commands\n\n| Command | Shape |\n|---|---|\n" + "\n".join(f"| `{command}` | `{shapes[command].replace('|', chr(92) + '|')}` |" for command in commands if command in shapes))


def flags_table(names):
    rows = []
    for flag in names:
        rows.append(f"| `{flag}` | {'switch' if flag in switches else 'takes a value'} |")
    return "| Flag | Kind |\n|---|---|\n" + "\n".join(rows)


groups = [
    ("render --app", "An app's shot, rendered by its own adapter.", "APP_FLAGS"),
    ("render --asset", "A logo, wordmark, lockup, tile or card on the path tracer.", "ASSET_FLAGS"),
    ("render --icons", "An icon set on the path tracer.", "ICONS_FLAGS"),
    ("render --scene", "A shot from a recipe folder's shots file on the path tracer.", "SCENE_FLAGS"),
    ("list --shots", "An app's shots.", "SHOTS_FLAGS"),
    ("list --presets", "The recipe folder's presets.", "PRESETS_FLAGS"),
    ("list --scenes", "The recipe folder's scene shots.", "SCENES_FLAGS"),
    ("encode", "Re-encode a master from its manifest.", "ENCODE_FLAGS"),
    ("cache", "The machine cache.", "CACHE_FLAGS"),
    ("bake", "Path-traced probes, lightmaps, plates and detail maps.", "BAKE_FLAGS"),
    ("steam stage", "Stage Steam's build scripts and depots.", "STEAM_FLAGS"),
]
cli.append("## Flags\n\nEach mode takes the flags below and refuses any other. A switch takes no value; any other flag takes one, as `--flag value` or `--flag=value`. `new`, `edit`, `bench`, `scene`, `font subset` and `archive` take what their usage lines above show.")
for name, line, constant in groups:
    cli.append(f"### pfx {name}\n\n{line}\n\n" + flags_table(rust_list(constant)))
cli.append("## Errors\n\nInput the tool can't parse gets clap's answer on stderr with exit 2: the error, the command's usage line and `For more information, try '--help'.` A refusal after a successful parse is one line, `pfx: …`, with exit 1. `pfx bench`'s flags and summary are in [Benchmark a scene](bundle:guides/benchmark-a-scene.md) and [Frame stats](bundle:guides/frame-stats.md#bench).")
cli_body = rewrite("\n\n".join(cli), "src/main.rs", "reference/cli.md")
write("reference/cli.md", front("The pfx tool", "Every command and flag of the pfx tool, generated from its usage text.", 901) + cli_body.strip("\n") + "\n")

changelog = read("CHANGELOG.md")
write("changelog.md", front("Changelog", "What changed in each pfx release.", 999) + rewrite(strip_title(changelog), "CHANGELOG.md", "changelog.md").strip("\n") + "\n")

match = re.search(r"^## " + re.escape(tag) + r"\b[^\n]*\n(.*?)(?=^## v|\Z)", changelog, re.S | re.M)
if not match or not match.group(1).strip():
    fail(f"CHANGELOG.md has no section for {tag}")
with open(notes_path, "w", encoding="utf-8") as handle:
    handle.write(match.group(1).strip("\n") + "\n")

if api:
    items = "\n".join(f'<li><a href="{crate.replace("-", "_")}/index.html">{crate}</a></li>' for crate in crates)
    write("api/index.html", f'<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n<title>pfx {tag} API</title>\n</head>\n<body>\n<h1>pfx {tag} API</h1>\n<ul>\n{items}\n</ul>\n</body>\n</html>\n')

used = set()
for folder, _, files in os.walk(dest):
    if os.path.relpath(folder, dest).split(os.sep)[0] == "api":
        continue
    for file in files:
        if file.endswith(".md"):
            with open(os.path.join(folder, file), encoding="utf-8") as handle:
                text = handle.read()
            for target in re.findall(r"\]\(([^)\s]+)\)", text):
                if re.match(r"^[a-z]+:", target):
                    continue
                path = target.partition("#")[0]
                if not path:
                    continue
                resolved = posixpath.normpath(posixpath.join(posixpath.relpath(folder, dest).replace(os.sep, "/"), path))
                if resolved.startswith("images/"):
                    used.add(resolved[len("images/"):])
                elif resolved.startswith("api/"):
                    if api and not os.path.exists(os.path.join(dest, resolved)):
                        fail(f"{file} links to a missing API page: {target}")
                elif not os.path.exists(os.path.join(dest, resolved)):
                    fail(f"{file} links to a missing page: {target}")
os.makedirs(os.path.join(dest, "images"), exist_ok=True)
notice = read("NOTICE.md")
for image in sorted(used):
    source = os.path.join(root, "docs", "images", image)
    if not os.path.exists(source):
        fail(f"a page uses docs/images/{image}, which does not exist")
    if image not in notice:
        fail(f"docs/images/{image} is not named in NOTICE.md")
    with open(source, "rb") as reader, open(os.path.join(dest, "images", image), "wb") as writer:
        writer.write(reader.read())

PY

if grep -rIlE '/home/|/Users/|/root/' "$stage/docs" >/dev/null; then
  echo "docs-bundle: an absolute local path reached the bundle:" >&2
  grep -rIlE '/home/|/Users/|/root/' "$stage/docs" >&2
  exit 1
fi

tarball=$out/docs-$tag.tar.gz
tar -czf "$tarball" -C "$stage" docs
echo "$tarball"
echo "$out/notes-$tag.md"
