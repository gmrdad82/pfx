#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
assets="${PITO_ASSETS:?PITO_ASSETS names the checkout of the PITO MD brand masters}"
rev=1bd7ff234db9487b517ce5fed50c76a94d0dbd3f
mkdir -p assets/marks .github
for file in pfx.svg wordmark.svg lockup.svg lockup-light.svg pfx-icon.png pfx.ico pfx.icns; do
  git -C "$assets" show "$rev:exports/pfx/assets/marks/$file" > "assets/marks/$file"
done
git -C "$assets" show "$rev:exports/pfx/.github/icon.png" > .github/icon.png
