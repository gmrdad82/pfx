#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
assets="${PITO_ASSETS:?PITO_ASSETS names the checkout of the PITO MD brand masters}"
rev=f5780929e8af805420c0640c7d801b42f655cda2
mkdir -p assets/marks .github
for file in pfx.svg wordmark.svg lockup.svg lockup-light.svg pfx-icon.png pfx.ico pfx.icns \
  powered-by.svg powered-by-64.png powered-by-128.png \
  powered-by-light.svg powered-by-light-64.png powered-by-light-128.png \
  powered-by-white.svg powered-by-white-64.png powered-by-white-128.png \
  powered-by-black.svg powered-by-black-64.png powered-by-black-128.png; do
  git -C "$assets" show "$rev:exports/pfx/assets/marks/$file" > "assets/marks/$file"
done
git -C "$assets" show "$rev:exports/pfx/.github/icon.png" > .github/icon.png
for crate in splash project workbench launcher; do
  rm -f "crates/$crate/assets/SOURCE"
done
for copy in crates/splash/assets/powered-by.svg crates/splash/assets/powered-by-light.svg \
  crates/project/assets/powered-by-128.png crates/project/assets/powered-by-light-128.png \
  crates/workbench/assets/pfx-icon.png crates/launcher/assets/pfx.ico; do
  dir=$(dirname "$copy")
  file=$(basename "$copy")
  mkdir -p "$dir"
  cp "assets/marks/$file" "$copy"
  echo "$file is assets/marks/$file, which bin/marks copies from the PITO MD brand masters at $rev (exports/pfx/assets/marks/$file) and into this folder, so the crate builds from its own folder." >> "$dir/SOURCE"
done
